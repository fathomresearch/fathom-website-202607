<section class="team" id="team" aria-label="Meet the team">
  <div class="team-inner sa">
    <div class="team-row">
    {% for employee in collections.employees %}
      <div class="tm sa s{{ loop.index }}">
        <div class="tm-photo-frame">
          {% siteImage employee.data.image, employee.data.name, "tm-photo" %}
        </div>
        <h3 class="tm-name">{{ employee.data.name }}</h3>
        <p class="tm-role">{{ employee.data.role }}</p>
      </div>
    {% endfor %}
    </div>
  </div>
</section>
